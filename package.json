{
  "name": "alpha-studio",
  "version": "0.1.0",
  "description": "Alpha Studio - noncommercial local coding workspace",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "scripts": {
    "skills:encode": "node scripts/encode-skills.mjs",
    "skills:release": "node scripts/build-skill-release.mjs",
    "skills:test": "node --test scripts/encode-skills.tests.mjs",
    "predev": "npm run skills:encode",
    "dev": "vite",
    "predev:prod": "npm run skills:encode",
    "dev:prod": "vite --mode production --host 127.0.0.1",
    "prebuild": "npm run skills:encode",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "npm run skills:test && vitest run",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:dev:prod": "tauri dev --config src-tauri/tauri.prod.conf.json",
    "tauri:build": "tauri build",
    "tauri:build:dmg": "tauri build --bundles dmg",
    "verify": "npm run test:run && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "d3-hierarchy": "^3.1.2",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^0.563.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "jsdom": "^29.0.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.2"
  }
}
