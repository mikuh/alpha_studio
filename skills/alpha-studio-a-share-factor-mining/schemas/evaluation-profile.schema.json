{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alpha-studio.local/schemas/a-share-factor-evaluation-profile.v1.json",
  "title": "A-share Factor Evaluation Profile",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "profile_name",
    "policy",
    "hard_gates",
    "heuristics",
    "required_dimensions"
  ],
  "properties": {
    "schema_version": {
      "const": "alpha.factor_evaluation_profile.v1"
    },
    "profile_name": {
      "type": "string"
    },
    "policy": {
      "type": "object",
      "required": [
        "heuristics_are_industry_standards",
        "allow_compensating_score"
      ],
      "properties": {
        "heuristics_are_industry_standards": {
          "const": false
        },
        "allow_compensating_score": {
          "const": false
        }
      }
    },
    "hard_gates": {
      "type": "object",
      "required": [
        "point_in_time",
        "historical_universe",
        "timing_validated",
        "trial_ledger_complete",
        "final_holdout_governed"
      ],
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "heuristics": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "number",
          "string",
          "boolean"
        ]
      }
    },
    "required_dimensions": {
      "type": "array",
      "minItems": 5,
      "items": {
        "enum": [
          "data",
          "predictive_power",
          "robustness",
          "multiple_testing",
          "tradability",
          "risk_exposure",
          "capacity",
          "crowding",
          "redundancy",
          "incremental_value",
          "shadow",
          "monitoring"
        ]
      }
    }
  }
}
