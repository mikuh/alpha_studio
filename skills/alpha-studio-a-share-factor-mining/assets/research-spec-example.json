{
  "schema_version": "alpha.factor_research.v1",
  "research_id": "cn-a-reversal-quality-001",
  "objective": "检验经质量和流动性约束后的中期价格反转是否能预测A股未来5个交易日横截面收益",
  "primary_archetype": "cross_sectional",
  "trial_family_id": "cn-a-reversal-quality-family",
  "hypothesis": {
    "mechanism": "短期流动性冲击和投资者过度反应可能导致中期超跌股票出现均值回归，但低质量和极低流动性股票会放大不可交易偏差",
    "falsifiable_prediction": "控制行业、规模、质量和流动性后，过去20日相对弱势股票在下一可交易时点起的5日收益应更高",
    "expected_direction": "positive",
    "failure_scenarios": [
      "收益只来自微盘或涨跌停后无法成交股票",
      "增加一个交易日延迟后信号消失",
      "中性化后预测方向反转",
      "悲观成本情景下净收益为负"
    ]
  },
  "universe": {
    "market": "CN_A",
    "exchanges": [
      "SSE",
      "SZSE"
    ],
    "boards": [
      "main",
      "chinext",
      "star"
    ],
    "historical_membership": true,
    "include_delisted": true,
    "tradability_policy": {
      "st": "exclude_at_decision_time",
      "suspension": "exclude_if_not_executable",
      "price_limit": "require_executable_volume_at_fill",
      "t_plus_one": true,
      "lot_size": "apply_security_rule_at_trade_date"
    }
  },
  "timing": {
    "frequency": "1d",
    "timezone": "Asia/Shanghai",
    "decision_time": "close(t) after official close data are available",
    "earliest_order_time": "open_auction(t+1)",
    "earliest_fill_time": "open(t+1) or configured VWAP window",
    "label_interval": "earliest_fill(t+1) to exit_fill(t+6)",
    "holding_period": "5 trading days",
    "rebalance_frequency": "1 trading day"
  },
  "data_split": {
    "discovery": {
      "start": "2014-01-01",
      "end": "2019-12-31"
    },
    "validation": {
      "start": "2020-01-01",
      "end": "2022-12-31"
    },
    "final_holdout": {
      "start": "2023-01-01",
      "end": "2025-12-31"
    }
  },
  "search_policy": {
    "allowed_methods": [
      "economic_template",
      "bounded_parameter_grid",
      "llm_multi_branch"
    ],
    "max_trials": 120,
    "stopping_rule": "达到预算或连续30个有效试验没有改善Pareto前沿时停止"
  },
  "guardrails": {
    "point_in_time_required": true,
    "record_all_trials": true,
    "final_holdout_single_use": true
  }
}
