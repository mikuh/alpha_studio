POSTGRES_DB=alpha_studio
POSTGRES_USER=alpha
POSTGRES_PASSWORD=alpha_password
DATABASE_URL=postgres://alpha:alpha_password@postgres:5432/alpha_studio
REDIS_URL=redis://redis:6379
APP_ENV=development
# 生产环境建议使用 json，便于日志平台检索 request_id、状态码和耗时。
LOG_FORMAT=pretty

APP_BASE_URL=http://localhost
VITE_ALPHA_API_BASE_URL=http://localhost
CADDY_SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# 必须分别生成两个不同的 32+ 字符随机值，例如：openssl rand -hex 32
JWT_SECRET=change-me-jwt-secret
RUN_TOKEN_SECRET=change-me-run-token-secret
AUTHORIZATION_CODE_ENCRYPTION_KEY=change-me-authorization-code-encryption-key
# 独立于其他密钥；生产环境不直接设置此项，而是通过
# PROVIDER_KMS_MASTER_KEY_FILE 挂载 KMS/Secret Manager 管理的密钥文件。
PROVIDER_KMS_MASTER_KEY=change-me-provider-kms-master-key
ADMIN_EMAIL=admin@alpha-studio.local
# 至少 12 字符；服务会拒绝占位值和弱默认值启动。
ADMIN_PASSWORD=change-me-admin-password
# RFC 4648 Base32，解码后至少 20 字节；录入认证器后用于后台 6 位动态验证码。
ADMIN_TOTP_SECRET=change-me-base32-totp-secret

# 按量模型最低毛利保护，单位 bp；500 = 5%。
MIN_GATEWAY_MARKUP_BPS=500

# 浏览器/桌面前端允许跨域调用 API 的明确 Origin 列表；禁止使用 *。
CORS_ALLOWED_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,http://localhost:1421,http://127.0.0.1:1421,tauri://localhost,http://tauri.localhost,https://tauri.localhost

# 云端行情聚合：东方财富主源，腾讯备源。上线前需确认展示/再分发授权。
MARKET_DATA_ENABLED=true
MARKET_REFRESH_SECONDS=45
MARKET_SNAPSHOT_LIMIT=8000
