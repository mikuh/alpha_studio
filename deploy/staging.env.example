APP_ENV=staging
LOG_FORMAT=json
APP_BASE_URL=https://staging.example.com
CADDY_SITE_ADDRESS=staging.example.com
CORS_ALLOWED_ORIGINS=https://staging-admin.example.com,tauri://localhost,http://tauri.localhost,https://tauri.localhost

# 从 staging 的密钥管理服务注入；各项必须不同，禁止提交真实值。
JWT_SECRET=change-me-staging-jwt-secret
RUN_TOKEN_SECRET=change-me-staging-run-token-secret
AUTHORIZATION_CODE_ENCRYPTION_KEY=change-me-staging-authorization-encryption-key
PROVIDER_KMS_MASTER_KEY=change-me-staging-provider-kms-key
ADMIN_PASSWORD=change-me-staging-admin-password
ADMIN_TOTP_SECRET=change-me-staging-base32-totp-secret

DATABASE_URL=postgres://alpha:replace-with-staging-db-password@postgres:5432/alpha_studio
REDIS_URL=redis://redis:6379
MIN_GATEWAY_MARKUP_BPS=500
MARKET_DATA_ENABLED=false
